# PhotoScore Environment Variables
# Copy this to .env and fill in your values

# ----------------------------------------------------
# 1. SECURITY & WEBHOOKS (Required for boot)
# Generate these securely (e.g. `openssl rand -hex 32`)
# ----------------------------------------------------
PHOTOSCORE_API_KEY=your_secure_api_key_here
META_APP_SECRET=your_meta_app_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ----------------------------------------------------
# 2. WhatsApp Cloud API (from Meta Developer Dashboard)
# ----------------------------------------------------
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=photoscore-verify-2026

# ----------------------------------------------------
# 3. Database (Supabase API)
# Go to Supabase Dashboard -> Project Settings -> API
# Note: Ensure RLS is enabled on your tables!
# ----------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_service_role_secret_key

# ----------------------------------------------------
# 4. Payment (Razorpay API Keys)
# ----------------------------------------------------
# RAZORPAY_KEY_ID=your_razorpay_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret
