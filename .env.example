# PhotoScore Environment Variables
# Copy this to .env and fill in your values

# WhatsApp Cloud API (from Meta Developer Dashboard)
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=photoscore-verify-2026

# Database (Supabase API)
# Go to Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_service_role_secret_key

# Payment (add when ready)
# RAZORPAY_KEY_ID=your_razorpay_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# STRIPE_SECRET_KEY=your_stripe_key
